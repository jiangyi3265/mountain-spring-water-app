{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "types": ["@dcloudio/types", "vite/client", "node"]
  },
  "include": ["App.vue", "main.js", "uni.promisify.adaptor.js", "services/**/*.js", "components/**/*.vue", "pages/**/*.vue", "vite.config.js"]
}
